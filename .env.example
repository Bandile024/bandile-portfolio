# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored, so your real keys never get committed.

# --- Contact / Request forms -------------------------------------------
# Create a free account at https://resend.com, verify a sending domain
# (or use their onboarding test domain while developing), then create an
# API key and paste it below. Without this, the forms still work — they
# just log submissions to the server console instead of emailing you.
RESEND_API_KEY=

# The address that should receive messages from the Contact and
# Request-a-Service forms.
CONTACT_TO_EMAIL=bandilengwenya21112002@gmail.com

# The "from" address Resend sends as. While using Resend's test domain
# this must be onboarding@resend.dev — once you verify your own domain
# you can change it to something like hello@yourdomain.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# --- Portfolio ------------------------------------------------------------
# Your GitHub username — the Portfolio page fetches your public repos
# live from the GitHub REST API using this value.
NEXT_PUBLIC_GITHUB_USERNAME=Bandile024
